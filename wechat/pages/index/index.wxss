.page {
  padding: 24rpx 28rpx 64rpx;
}

.hero {
  padding: 24rpx 8rpx 32rpx;
}

.eyebrow {
  color: #3275e7;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 12rpx;
  color: #758195;
  font-size: 25rpx;
  line-height: 1.6;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(26, 43, 68, 0.05);
}

.section-title {
  margin-bottom: 22rpx;
  font-size: 29rpx;
  font-weight: 650;
}

.mode-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.mode-item {
  padding: 20rpx;
  border: 2rpx solid #e9edf3;
  border-radius: 14rpx;
}

.mode-item-active {
  border-color: #3275e7;
  background: #f2f7ff;
}

.mode-title {
  font-size: 25rpx;
  font-weight: 600;
}

.mode-description {
  margin-top: 8rpx;
  color: #758195;
  font-size: 21rpx;
}

.field-label {
  margin: 18rpx 0 10rpx;
  color: #596579;
  font-size: 23rpx;
}

.field {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #e9edf3;
  border-radius: 12rpx;
  background: #fff;
  font-size: 25rpx;
}

.textarea {
  height: 150rpx;
}

.submit-button {
  margin-top: 28rpx;
  border-radius: 12rpx;
  background: #3275e7;
  color: #fff;
  font-weight: 600;
}

.submit-button[disabled] {
  background: #91afe3;
  color: #fff;
}

.privacy-note {
  margin-top: 16rpx;
  color: #8a94a4;
  font-size: 21rpx;
  line-height: 1.5;
}

.message {
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.error {
  background: #fff0f0;
  color: #bd3434;
}

.result-card {
  overflow: hidden;
}

.result-block {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f6f8fb;
}

.result-label {
  margin-bottom: 10rpx;
  color: #596579;
  font-size: 23rpx;
  font-weight: 600;
}

.result-content {
  display: block;
  color: #465267;
  font-family: monospace;
  font-size: 21rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
